{
  "build": {
    "core": "esp32",
    "extra_flags": [
      "-DARDUINO_ESP32C6_DEV",
      "-DARDUINO_ARCH_ESP32"
    ],
    "f_cpu": "160000000L",
    "f_flash": "80000000L",
    "flash_mode": "dio",
    "hwids": [
      [
        "0x303A",
        "0x4003"
      ]
    ],
    "mcu": "esp32c6",
    "variant": "esp32c6"
  },
  "connectivity": [
    "wifi",
    "bluetooth"
  ],
  "debug": {
    "openocd_target": "esp32c6.cfg"
  },
  "frameworks": [
    "espidf"
  ],
  "name": "Seeed XIAO ESP32C6 - vizn3r edition",
  "upload": {
    "flash_size": "4MB",
    "maximum_ram_size": 327680,
    "maximum_size": 4194304,
    "require_upload_port": true,
    "speed": 921600
  },
  "url": "https://docs.espressif.com/projects/esp-idf/en/latest/esp32c6/hw-reference/esp32c6/user-guide-devkitc-1.html",
  "vendor": "Espressif"
}
